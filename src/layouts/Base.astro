---
import '../styles/global.css'
import { SITE_NAME } from '../site.js'
import { asset, home } from '../href.js'

// Imported rather than referenced by path so the build hashes them and applies
// the base; the preload hrefs then match what the stylesheet actually requests.
import newsreaderUrl from '../fonts/newsreader.woff2?url'
import plexMonoUrl from '../fonts/plex-mono-500.woff2?url'

interface Props {
  title: string
  description: string
  /** Path for the canonical URL, already carrying the base. */
  canonical: string
  /** Basename of the social image under /og/. */
  ogSlug: string
  ogType?: string
  /** Set on entry pages so the arrow keys know where to go. */
  slug?: string
  prev?: string
  next?: string
}

const {
  title,
  description,
  canonical,
  ogSlug,
  ogType = 'website',
  slug,
  prev,
  next,
} = Astro.props

const canonicalURL = new URL(canonical, Astro.site)
const ogImage = new URL(asset(`og/${ogSlug}.svg`), Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0705" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />

    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMonoUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body data-slug={slug} data-prev={prev} data-next={next} data-home={home()}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <script>
      // ── The draw ──────────────────────────────────────────────────────
      // Random, and it does not repeat a card until every card has come up.
      const KEY = 'mwlb:drawn'
      const BASE = document.body.dataset.home || '/'

      function readDrawn(all: string[]): string[] {
        try {
          const raw = JSON.parse(localStorage.getItem(KEY) || '[]')
          return Array.isArray(raw) ? raw.filter((s) => all.includes(s)) : []
        } catch {
          return []
        }
      }

      function pick(all: string[], current: string | null): string {
        let drawn = readDrawn(all)
        let pool = all.filter((s) => !drawn.includes(s) && s !== current)

        // Every card has been seen: start a fresh pass.
        if (pool.length === 0) {
          drawn = []
          pool = all.filter((s) => s !== current)
        }

        const choice = pool[Math.floor(Math.random() * pool.length)]
        try {
          localStorage.setItem(KEY, JSON.stringify([...drawn, choice]))
        } catch {
          /* private mode; the draw still works, it just stops remembering */
        }
        return choice
      }

      document.querySelectorAll<HTMLElement>('[data-draw]').forEach((el) => {
        el.addEventListener('click', (event) => {
          const all = (el.dataset.draw || '').split(',').filter(Boolean)
          if (all.length === 0) return
          event.preventDefault()
          const current = document.body.dataset.slug || null
          window.location.href = `${BASE}${pick(all, current)}/`
        })
      })

      // ── Arrow keys move through the collection ────────────────────────
      const prev = document.body.dataset.prev
      const next = document.body.dataset.next

      if (prev || next) {
        window.addEventListener('keydown', (event) => {
          if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return
          const target = event.target as HTMLElement | null
          if (target && target.closest('input, textarea, select, [contenteditable]')) return

          if (event.key === 'ArrowLeft' && prev) {
            event.preventDefault()
            window.location.href = prev
          } else if (event.key === 'ArrowRight' && next) {
            event.preventDefault()
            window.location.href = next
          } else if (event.key === 'Escape') {
            event.preventDefault()
            window.location.href = BASE
          }
        })
      }
    </script>
  </body>
</html>
