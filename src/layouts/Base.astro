---
import '../styles/global.css'
import { SITE_NAME } from '../site.js'

interface Props {
  title: string
  description: string
  /** Family key, used for the accent color in social metadata. */
  accent?: string
  ogType?: string
  canonical?: string
  /** Set on entry pages so the arrow keys know where to go. */
  slug?: string
  prev?: string
  next?: string
}

const {
  title,
  description,
  accent = '#d8b25e',
  ogType = 'website',
  canonical = Astro.url.pathname,
  slug,
  prev,
  next,
} = Astro.props

const canonicalURL = new URL(canonical, Astro.site)
const ogImage = new URL(`/og/${canonical.replace(/\//g, '') || 'home'}.svg`, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={accent} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/newsreader.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plex-mono-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body data-slug={slug} data-prev={prev} data-next={next}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <script>
      // ── The draw ──────────────────────────────────────────────────────
      // Random, and it does not repeat a card until every card has come up.
      const KEY = 'mwlb:drawn'

      function readDrawn(all: string[]): string[] {
        try {
          const raw = JSON.parse(localStorage.getItem(KEY) || '[]')
          return Array.isArray(raw) ? raw.filter((s) => all.includes(s)) : []
        } catch {
          return []
        }
      }

      function pick(all: string[], current: string | null): string {
        let drawn = readDrawn(all)
        let pool = all.filter((s) => !drawn.includes(s) && s !== current)

        // Every card has been seen: start a fresh pass.
        if (pool.length === 0) {
          drawn = []
          pool = all.filter((s) => s !== current)
        }

        const choice = pool[Math.floor(Math.random() * pool.length)]
        try {
          localStorage.setItem(KEY, JSON.stringify([...drawn, choice]))
        } catch {
          /* private mode; the draw still works, it just stops remembering */
        }
        return choice
      }

      document.querySelectorAll<HTMLElement>('[data-draw]').forEach((el) => {
        el.addEventListener('click', (event) => {
          const all = (el.dataset.draw || '').split(',').filter(Boolean)
          if (all.length === 0) return
          event.preventDefault()
          const current = document.body.dataset.slug || null
          window.location.href = `/${pick(all, current)}/`
        })
      })

      // ── Arrow keys move through the collection ────────────────────────
      const prev = document.body.dataset.prev
      const next = document.body.dataset.next

      if (prev || next) {
        window.addEventListener('keydown', (event) => {
          if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return
          const target = event.target as HTMLElement | null
          if (target && target.closest('input, textarea, select, [contenteditable]')) return

          if (event.key === 'ArrowLeft' && prev) {
            event.preventDefault()
            window.location.href = prev
          } else if (event.key === 'ArrowRight' && next) {
            event.preventDefault()
            window.location.href = next
          } else if (event.key === 'Escape') {
            event.preventDefault()
            window.location.href = '/'
          }
        })
      }
    </script>
  </body>
</html>
