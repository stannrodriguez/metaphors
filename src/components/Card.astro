---
import Glyph from './Glyph.astro'
import { entry } from '../href.js'

interface Props {
  metaphor: {
    slug: string
    name: string
    oneLiner: string
  }
}
const { metaphor } = Astro.props
---

<a class="card" href={entry(metaphor.slug)}>
  <span class="card__face">
    <span class="card__glyph">
      <span class="card__glyph-in"><Glyph slug={metaphor.slug} animate /></span>
    </span>
    <span class="card__name">{metaphor.name}</span>
    <span class="card__line">{metaphor.oneLiner}</span>
  </span>
</a>
