---
import Glyph from './Glyph.astro'
import { entry } from '../href.js'
import { families } from '../data/families.js'

interface Props {
  metaphor: {
    slug: string
    name: string
    oneLiner: string
    family: string
  }
}
const { metaphor } = Astro.props
const family = families[metaphor.family as keyof typeof families]
---

<a class="card" id={`metaphor-${metaphor.slug}`} href={entry(metaphor.slug)}>
  <span class="card__face">
    <span class="card__glyph">
      <span class="card__glyph-in"><Glyph slug={metaphor.slug} animate /></span>
    </span>
    <span class="card__family">{family.name}</span>
    <span class="card__name">{metaphor.name}</span>
    <span class="card__line">{metaphor.oneLiner}</span>
  </span>
</a>
