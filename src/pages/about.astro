---
import Base from '../layouts/Base.astro'
import { about, home } from '../href.js'
import { SITE_NAME } from '../site.js'
---

<Base
  title={`About · ${SITE_NAME}`}
  description="The intent, method, influences, and authorship behind Metaphors Worth Living By."
  canonical={about()}
  ogSlug="home"
>
  <div class="shell shell--about">
    <div class="inner inner--about">
      <nav class="entrynav" aria-label="Collection">
        <div class="entrynav__side">
          <a href={home()} rel="up">&larr; All twenty</a>
        </div>
      </nav>

      <main class="about" id="main">
        <p class="about__eyebrow">The collection</p>
        <h1>About {SITE_NAME}</h1>
        <p class="about__lede">
          Twenty metaphors for seeing a choice from a more useful angle. Each one names the
          moment when it helps, explains the physical logic that gives it force, and records
          the point where the analogy stops telling the truth.
        </p>

        <section>
          <h2>Why metaphor</h2>
          <p>
            The title and premise are indebted to George Lakoff and Mark Johnson's
            <a href="https://press.uchicago.edu/ucp/books/book/chicago/M/bo3637992.html"
              >Metaphors We Live By</a
            >. Their work treats metaphor as part of how people organize thought and action,
            not simply as decoration added to language.
          </p>
        </section>

        <section>
          <h2>How to use the collection</h2>
          <p>
            Draw a card when a situation feels stuck, browse by family when you can name the
            kind of problem, or move through all twenty in order. Keep the mechanics and the
            breaking point together: a metaphor becomes dangerous when its limits disappear.
          </p>
        </section>

        <section>
          <h2>Authorship</h2>
          <p>
            Created and maintained by
            <a href="https://github.com/stannrodriguez" rel="author">@stannrodriguez</a>.
            The project, its writing, and its original glyphs are available in the
            <a href="https://github.com/stannrodriguez/metaphors">source repository</a>.
          </p>
        </section>
      </main>
    </div>
  </div>
</Base>

<style>
  .shell--about {
    align-items: flex-start;
    padding-top: 42px;
    padding-bottom: 42px;
  }

  .inner--about {
    max-width: 760px;
  }

  .about {
    border: 1px solid var(--rule-panel);
    border-radius: var(--panel-radius);
    background: var(--panel-face);
    box-shadow: var(--panel-shadow);
    padding: clamp(28px, 6vw, 62px);
  }

  .about__eyebrow,
  .about h2 {
    margin: 0;
    font: 500 10.5px/1.4 var(--mono);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-label);
  }

  .about h1 {
    margin: 12px 0 0;
    font: 500 clamp(28px, 5vw, 42px) / 1.2 var(--serif);
    letter-spacing: 0.08em;
    color: var(--gold);
    text-wrap: balance;
  }

  .about__lede {
    margin: 20px 0 0;
    font: italic 400 19px/1.65 var(--serif);
    color: var(--text-full);
    text-wrap: pretty;
  }

  .about section {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--rule-hair);
  }

  .about section p {
    margin: 8px 0 0;
    font: 400 16px/1.7 var(--serif);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .about section a {
    text-decoration: underline;
    text-decoration-color: var(--rule-chip);
    text-underline-offset: 3px;
  }

  @media (max-width: 620px) {
    .shell--about {
      padding-top: 26px;
    }

    .about {
      padding: 26px 22px;
    }

    .about__lede {
      font-size: 17px;
    }
  }
</style>
