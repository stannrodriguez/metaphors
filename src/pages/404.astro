---
import Base from '../layouts/Base.astro'
import { metaphors } from '../data/metaphors.js'
import { SITE_NAME } from '../site.js'
import { home, asset } from '../href.js'

const allSlugs = metaphors.map((m) => m.slug).join(',')
---

<Base
  title={`Page not found · ${SITE_NAME}`}
  description="That page is not in the collection. Browse all twenty metaphors or draw one at random."
  canonical={asset("404/")}
  ogSlug="home"
>
  <main class="shell" id="main">
    <div class="inner lost">
      <p class="intro__stars" aria-hidden="true">✦ ✦ ✦</p>
      <h1 class="intro__title">Page not found</h1>
      <p class="intro__body">
        That address is not in this collection. Check the URL, browse all twenty metaphors, or draw one at random.
      </p>
      <hr class="rule" />
      <p class="lost__links">
        <a href={home()} aria-label="Back to all twenty metaphors">All cards</a>
        <button class="draw" type="button" data-draw={allSlugs} aria-label="Draw a random card">Draw a card &rarr;</button>
      </p>
    </div>
  </main>
</Base>

<style>
  .lost {
    max-width: 580px;
    text-align: center;
    margin: 0 auto;
  }
  .lost__links {
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: center;
    margin: 13px 0 0;
    font: 500 9.5px var(--mono);
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }
  .lost__links .draw {
    margin: 0;
  }
</style>
