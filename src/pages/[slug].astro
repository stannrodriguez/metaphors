---
import Base from '../layouts/Base.astro'
import EntryArticle from '../components/EntryArticle.astro'
import { metaphors, bySlug, neighbors } from '../data/metaphors.js'
import { SITE_NAME } from '../site.js'
import { entry, home } from '../href.js'

export function getStaticPaths() {
  return metaphors.map((m) => ({ params: { slug: m.slug } }))
}

const { slug } = Astro.params
const m = bySlug[slug]
const { prev, next } = neighbors(m.slug)

const allSlugs = metaphors.map((x) => x.slug).join(',')
---

<Base
  title={`${m.name} · ${SITE_NAME}`}
  description={m.oneLiner}
  ogType="article"
  canonical={entry(m.slug)}
  ogSlug={m.slug}
  slug={m.slug}
  prev={entry(prev.slug)}
  next={entry(next.slug)}
>
  <div class="shell">
    <div class="inner inner--entry">
      <nav class="entrynav" aria-label="Collection">
        <div class="entrynav__side">
          <a href={home()} rel="up">&larr; All twenty</a>
        </div>
        <div class="entrynav__side">
          <span class="kbd-hint" aria-hidden="true">&larr; &rarr; to browse</span>
          <a href={entry(prev.slug)} rel="prev">Prev</a>
          <a href={entry(next.slug)} rel="next">Next</a>
          <button class="draw" type="button" data-draw={allSlugs}>Draw again &#8635;</button>
        </div>
      </nav>

      <main class="entry" id="main">
        <EntryArticle slug={m.slug} level={1} />
      </main>
    </div>
  </div>
</Base>

<style>
  .inner--entry {
    max-width: 940px;
  }

  .shell {
    align-items: flex-start;
    padding-top: 42px;
    padding-bottom: 42px;
  }

  @media (max-width: 900px) {
    .shell {
      padding-top: 26px;
    }
  }
</style>
